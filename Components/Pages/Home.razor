@page "/"
@rendermode InteractiveServer
@inject UrlShortener UrlShortener
@inject NavigationManager Navigation

<PageTitle>Сокращение URL</PageTitle>

<h1>Сокращение URL</h1>

<div class="mb-3">
    <label class="form-label" for="long-url">Длинный URL</label>
    <input id="long-url"
           class="form-control"
           @bind="longUrl"
           @bind:event="oninput"
           placeholder="https://example.com/very/long/url"/>
</div>

<button type="button" class="btn btn-primary mb-3" @onclick="CompressAsync" disabled="@isBusy">
    Сжать
</button>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="mb-3">
    <label class="form-label" for="short-url">Сокращенный URL</label>
    <input id="short-url" class="form-control" value="@shortUrl" readonly/>
</div>

@code {
    private string longUrl = string.Empty;
    private string shortUrl = string.Empty;
    private string? error;
    private bool isBusy;

    private async Task CompressAsync()
    {
        error = null;
        shortUrl = string.Empty;
        isBusy = true;

        try
        {
            var created = await UrlShortener.CreateAsync(longUrl);
            shortUrl = Navigation.ToAbsoluteUri(created.Hash).ToString();
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

}
